name "quickbite"
description "Bytecode VM for the D programming language"
copyright "Copyright © 2026, atila"
license "BSL-1.0"

// When bumping dmd:frontend, re-run scripts/vendor-dmd-backend.sh to
// keep vendor/dmd-backend/ in sync with the new version.
subPackage {
    name "dmd-backend-vendor"
    targetType "sourceLibrary"
    sourcePaths "vendor/dmd-backend"
    importPaths "vendor/dmd-backend"
}

// The DMD-built run executor. The LDC benchmark host cannot run DMD-codegen'd
// unittests in-process (extern(D) ABI divergence, ai/spikes/ldc-eh/FINDINGS.md),
// so under the LDC build SystemLinker hands the linked `.so` + symbol names to
// this tiny standalone executable, which dlopens and runs them across a process
// boundary. It deliberately imports nothing from the quickbite/dmd packages, so
// as a subPackage with its own sourcePaths it builds without the dmd frontend.
// Build it with DMD so its druntime matches the DMD-codegen'd `.so`.
subPackage {
    name "bench-exec"
    targetType "executable"
    targetName "bench-exec"
    targetPath "bin"
    sourcePaths "bench-exec"
    importPaths "bench-exec"
    // Shared druntime so core.runtime.Runtime.loadLibrary can load the
    // generated `.so`, matching how SystemLinker links it.
    dflags "-defaultlib=libphobos2.so"
}

configuration "unittest" {
    targetType "executable"
    targetName "ut"
    targetPath "bin"

    mainSourceFile "tests/main.d"
    sourcePaths "tests" "benchmarks"
    sourceFiles "benchmarks/cli.d" "benchmarks/harness.d" "benchmarks/backends.d"
    importPaths "tests" "benchmarks"
    versions "unitUnthreaded"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"
    // dmd:frontend and :dmd-backend-vendor both define the same DMD backend
    // symbols; --allow-multiple-definition lets the linker accept either copy.
    lflags "--allow-multiple-definition" platform="linux"
    // LLVMJit links the ORC JIT in-process. A bare libLLVM.so symlink is
    // installed, so plain -lLLVM resolves the versioned runtime.
    libs "LLVM" platform="linux"
    // The resident native-call chokepoint (quickbite.backends.ffi) builds
    // libffi call interfaces; plain -lffi resolves the installed runtime.
    libs "ffi" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "unit-threaded" version="*"
}

configuration "unittest-cov" {
    targetType "executable"
    targetName "ut-cov"
    targetPath "bin"

    mainSourceFile "tests/main.d"
    sourcePaths "tests" "tests/coverage"
    importPaths "tests"
    versions "unitUnthreaded"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"

    // Pair this config with `--build=unittest-cov`; dub will then pass
    // `-unittest -cov`. dub warns if these are listed as buildOptions
    // here directly.
    // dmd:frontend and :dmd-backend-vendor both define the same DMD backend
    // symbols; --allow-multiple-definition lets the linker accept either copy.
    lflags "--allow-multiple-definition" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "unit-threaded" version="*"
}

configuration "benchmark" {
    targetType "executable"
    targetName "bench"
    targetPath "bin"

    mainSourceFile "benchmarks/main.d"
    sourcePaths "benchmarks"
    importPaths "benchmarks"
    dflags "-defaultlib=libphobos2.so"
    versions "QuickbiteRuntimeLoadLibrary"
    // The native package (linked in via source/) references the ORC JIT, so
    // the benchmark binary must link libLLVM too. A bare libLLVM.so symlink is
    // installed, so plain -lLLVM resolves the versioned runtime.
    libs "LLVM" platform="linux"
    // The resident native-call chokepoint (quickbite.backends.ffi) builds
    // libffi call interfaces; plain -lffi resolves the installed runtime.
    libs "ffi" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
}

// LDC-built sibling of `benchmark`. LDC nearly halves the frontend
// (parse + semantic) row, which executes no generated code and so carries
// none of the extern(D)/EH ABI hazards that block running DMD-codegen'd
// native tests on an LDC host (ai/spikes/ldc-eh/FINDINGS.md). The only
// DMD-only flag swapped out is `-defaultlib=libphobos2.so`; LDC links the
// shared default libraries with `-link-defaultlib-shared`. Native post-parse
// backends (system-linker, llvm-jit) are unavailable under this build until
// the DMD run executor lands; the cli refuses them with a clear message.
configuration "benchmark-ldc" {
    targetType "executable"
    targetName "bench"
    targetPath "bin"

    mainSourceFile "benchmarks/main.d"
    sourcePaths "benchmarks"
    // The version(LDC) SystemLinker run path hands tests to the DMD-built
    // bench-exec subPackage; both sides share its run_wire module.
    sourceFiles "bench-exec/run_wire.d"
    importPaths "benchmarks" "bench-exec"
    dflags "-link-defaultlib-shared"
    versions "QuickbiteRuntimeLoadLibrary"
    // The native package (linked in via source/) references the ORC JIT, so
    // the benchmark binary must link libLLVM too. A bare libLLVM.so symlink is
    // installed, so plain -lLLVM resolves the versioned runtime.
    libs "LLVM" platform="linux"
    // The resident native-call chokepoint (quickbite.backends.ffi) builds
    // libffi call interfaces; plain -lffi resolves the installed runtime.
    libs "ffi" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
}

configuration "qb" {
    targetType "executable"
    targetName "qb"
    targetPath "bin"

    mainSourceFile "repl/main.d"
    sourcePaths "source" "repl"
    importPaths "source" "repl"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"
    lflags "--allow-multiple-definition" platform="linux"
    // The native package (linked in via source/) references the ORC JIT, so
    // qb must link libLLVM too even though the REPL does not select this
    // backend. A bare libLLVM.so symlink is installed, so -lLLVM resolves it.
    libs "LLVM" platform="linux"
    // The resident native-call chokepoint (quickbite.backends.ffi) builds
    // libffi call interfaces; plain -lffi resolves the installed runtime.
    libs "ffi" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "colorize" version="~>1.0.5"
    dependency "readline" version="0.3.0"
}

// `-inline` causes DMD to hang on large lowering.d; omit it until the
// file is split into smaller modules.
buildType "benchmark-opt" {
    buildOptions "optimize" "releaseMode" "noBoundsCheck"
}
