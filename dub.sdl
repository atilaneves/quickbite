name "quickbite"
description "Bytecode VM for the D programming language"
copyright "Copyright © 2026, atila"
license "BSL-1.0"

// When bumping dmd:frontend, re-run scripts/vendor-dmd-backend.sh to
// keep vendor/dmd-backend/ in sync with the new version.
subPackage {
    name "dmd-backend-vendor"
    targetType "sourceLibrary"
    sourcePaths "vendor/dmd-backend"
    importPaths "vendor/dmd-backend"
}

configuration "unittest" {
    targetType "executable"
    targetName "ut"
    targetPath "bin"

    mainSourceFile "tests/main.d"
    sourcePaths "tests" "benchmarks"
    sourceFiles "benchmarks/cli.d" "benchmarks/harness.d"
    importPaths "tests" "benchmarks"
    versions "unitUnthreaded"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"
    // dmd:frontend and :dmd-backend-vendor both define the same DMD backend
    // symbols; --allow-multiple-definition lets the linker accept either copy.
    lflags "--allow-multiple-definition" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "unit-threaded" version="*"
}

configuration "unittest-cov" {
    targetType "executable"
    targetName "ut-cov"
    targetPath "bin"

    mainSourceFile "tests/main.d"
    sourcePaths "tests" "tests/coverage"
    importPaths "tests"
    versions "unitUnthreaded"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"

    // Pair this config with `--build=unittest-cov`; dub will then pass
    // `-unittest -cov`. dub warns if these are listed as buildOptions
    // here directly.
    // dmd:frontend and :dmd-backend-vendor both define the same DMD backend
    // symbols; --allow-multiple-definition lets the linker accept either copy.
    lflags "--allow-multiple-definition" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "unit-threaded" version="*"
}

configuration "benchmark" {
    targetType "executable"
    targetName "bench"
    targetPath "bin"

    mainSourceFile "benchmarks/main.d"
    sourcePaths "benchmarks"
    importPaths "benchmarks"
    dflags "-defaultlib=libphobos2.so"
    versions "QuickbiteRuntimeLoadLibrary"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
}

configuration "qb" {
    targetType "executable"
    targetName "qb"
    targetPath "bin"

    mainSourceFile "repl/main.d"
    sourcePaths "source" "repl"
    importPaths "source" "repl"
    // Shared druntime so DynamicLibrary can Runtime.loadLibrary the shared
    // libraries it builds.
    dflags "-defaultlib=libphobos2.so"
    lflags "--allow-multiple-definition" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency ":dmd-backend-vendor" version="*"
    dependency "colorize" version="~>1.0.5"
    dependency "readline" version="0.3.0"
}

// `-inline` causes DMD to hang on large lowering.d; omit it until the
// file is split into smaller modules.
buildType "benchmark-opt" {
    buildOptions "optimize" "releaseMode" "noBoundsCheck"
}
