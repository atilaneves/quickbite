name "quickbite"
description "Bytecode VM for the D programming language"
copyright "Copyright © 2026, atila"
license "BSL-1.0"

configuration "unittest" {
    targetType "executable"
    targetName "ut"

    mainSourceFile "tests/main.d"
    sourcePaths "tests"
    includePaths "tests"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency "unit-threaded" version="*"
}

configuration "unittest-cov" {
    targetType "executable"
    targetName "ut-cov"

    mainSourceFile "tests/main.d"
    sourcePaths "tests"
    includePaths "tests"

    // Pair this config with `--build=unittest-cov`; dub will then pass
    // `-unittest -cov`. dub warns if these are listed as buildOptions
    // here directly.
    lflags "--allow-multiple-definition" platform="linux"

    dependency "dmd:frontend" version="~>2.112.0"
    dependency "unit-threaded" version="*"
}

configuration "benchmark" {
    targetType "executable"
    targetName "bench"

    mainSourceFile "benchmarks/main.d"
    sourcePaths "benchmarks"
    includePaths "benchmarks"

    dependency "dmd:frontend" version="~>2.112.0"
}
